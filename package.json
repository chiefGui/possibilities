{
  "name": "possibilities",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "vp run @possibilities/desktop#dev",
    "dev:web": "vp run @possibilities/web#dev",
    "build": "vp run -r build",
    "start": "vp run @possibilities/desktop#start",
    "typecheck": "vp run -r typecheck",
    "check": "vp check",
    "ready": "vp check && vp run -r typecheck && vp run -r build",
    "prepare": "vp config --no-agent"
  },
  "devDependencies": {
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "overrides": {
    "vite": "catalog:"
  },
  "browserslist": [
    "chrome >= 123",
    "safari >= 17.5",
    "firefox >= 120"
  ],
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.4.4",
      "onFail": "download"
    }
  },
  "engines": {
    "node": "^22.22.1 || >=24.11.0"
  },
  "catalog": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.5.0",
    "vite-plus": "1.5.0"
  }
}
