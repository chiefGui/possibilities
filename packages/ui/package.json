    "@types/react": "^19.3.0",
    "react": "^19.3.1",
    "tsrs": "^0.21.0-ts7.1.0-beta",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "react": "^19.3.1"
  }
