    "./actions": "./src/actions.tsx",
    "./alert-dialog": "./src/alert-dialog.tsx",
    "./button": "./src/button.tsx",
    "./combobox": "./src/combobox.tsx",
    "./editable-text": "./src/editable-text.tsx",
    "./field": "./src/field.tsx",
    "./form": "./src/form.tsx",
    "./icon": "./src/icon.tsx",
    "./input": "./src/input.tsx",
    "./menu": "./src/menu.tsx",
    "./props": "./src/props.ts",
    "./row": "./src/row.ts",
    "./scroll-area": "./src/scroll-area.tsx",
    "./states": "./src/states.ts",
    "./status-icon": "./src/status-icon.tsx",
    "./tabs": "./src/tabs.tsx",
    "./text": "./src/text.ts",
    "./tooltip": "./src/tooltip.tsx",
    "./panda/*": "./dist/panda/*",
    "./css": {
      "types": "./styled-system/css/index.d.ts",
      "default": "./styled-system/css/index.js"
